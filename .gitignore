# data: 运行时产物，绝不入库（Kaggle 卡数据 / 规则原文 / 本地 db）
data/
*.db
*.sqlite
*.faiss
*.index
*.jsonl

# 例外：引擎自有的**卡池与卡表定义**（项目自撰，仅卡名/数值映射，无官方图像）需入库
!packages/engine/engine/data/
!packages/engine/engine/data/*.json
# 例外：K2 效果解析黄金集（手工标注真值，项目自撰）需入库
!packages/agent/data/
!packages/agent/data/*.json

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/

# 本地模型权重
*.safetensors
*.bin
*.onnx
*.pt
artifacts/

# 例外：量化精度报告要进版本库——它是「确保数据精度」的**验收证据**（约 24KB，
# 由 apps/api/scripts/qwen_precision.py 复跑覆盖生成）。
# 注意写法：git 不允许重新包含「父目录已被排除」的文件，故必须先解禁目录本身，
# 再排除其余内容、最后单独放行。**加前导斜杠是为了只作用于仓库根**，
# 避免把 packages/agent/artifacts/（含 .pt 权重）一并解禁。
!/artifacts/
/artifacts/*
!/artifacts/qwen_precision_report.md
!/artifacts/qwen_precision_report.json
# 非默认档位（4bit）与两档对照——同样属验收证据，按档位分文件存放，
# 避免跑 4bit 时把 8bit 的证据覆盖掉（见 qwen_precision.py::_report_paths）。
!/artifacts/qwen_precision_report_4bit.md
!/artifacts/qwen_precision_report_4bit.json
!/artifacts/qwen_precision_compare.md
!/artifacts/qwen_precision_compare.json
!/artifacts/local_llm_verify.json
# K2 达标率实测（本地模型真跑卡池解析）——决定是否启用 ADR-LLM-001 云端保底的依据。
# 注意：脚本自己写 `artifacts/_k2_eval_audit.jsonl`（临时审计），**不**在此放行。
!/artifacts/k2_local_eval.md
!/artifacts/k2_local_eval.json
!/artifacts/k2_local_eval_4bit.md
!/artifacts/k2_local_eval_4bit.json

# 编辑器 / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地对局导出
match_*.jsonl

# web
node_modules/
# 构建产物：dist 与受限环境回退用的 dist2/dist3/…（见 apps/api/app/main.py
# `_pick_web_dist()`——Windows 上 dist 被占用时改构建到 distN，服务自动挑最新）。
# 用一条通配覆盖全部，避免每新建一个 distN 就要加一行（历史上漏过 dist15）。
apps/web/dist*/
apps/web/shots.json
apps/web/shots.err
apps/web/_write_memory.py
apps/api/tests/_append_tests.py
apps/api/data/
# 例外：M1 卡牌数据集清洗产物（项目自撰规范化数据 + 质量报告）
# 注意：必须先解禁父目录 data/（git 不会进入被排除的目录），再单独排除 db/
!packages/card-db/data/
packages/card-db/data/db/
!packages/card-db/data/cleaned/
!packages/card-db/data/cleaned/*.json
!packages/card-db/data/cleaned/*.md
apps/web/dist15/

# E2E 运行产物（真实 Chrome 截图 + 结果 JSON；可用 node *_e2e.cjs 重新生成）
# 说明：脚本默认把产物写到 cwd（apps/web），故按前缀忽略，避免污染仓库。
apps/web/*.png
apps/web/cmd_*.json
apps/web/comp_*.json
apps/web/lib_*.json
apps/web/seq_*.json
apps/web/zh_*.json
apps/web/zhin_*.json
apps/web/focus_*.json
apps/web/batch_*.json
apps/web/modelcfg_*.json
# 兜底：E2E 结果 JSON 一律以 _e2e.json 结尾（新增脚本无需再逐条登记）
apps/web/*_e2e.json
