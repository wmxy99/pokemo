# data: 运行时产物，绝不入库（Kaggle 卡数据 / 规则原文 / 本地 db）
data/
*.db
*.sqlite
*.faiss
*.index
*.jsonl

# 例外：引擎自有的**卡池与卡表定义**（项目自撰，仅卡名/数值映射，无官方图像）需入库
!packages/engine/engine/data/
!packages/engine/engine/data/*.json
# 例外：K2 效果解析黄金集（手工标注真值，项目自撰）需入库
!packages/agent/data/
!packages/agent/data/*.json

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/

# 本地模型权重
*.safetensors
*.bin
*.onnx
*.pt
artifacts/

# 例外：量化精度报告要进版本库——它是「确保数据精度」的**验收证据**（约 24KB，
# 由 apps/api/scripts/qwen_precision.py 复跑覆盖生成）。
# 注意写法：git 不允许重新包含「父目录已被排除」的文件，故必须先解禁目录本身，
# 再排除其余内容、最后单独放行。**加前导斜杠是为了只作用于仓库根**，
# 避免把 packages/agent/artifacts/（含 .pt 权重）一并解禁。
!/artifacts/
/artifacts/*
!/artifacts/qwen_precision_report.md
!/artifacts/qwen_precision_report.json
# 非默认档位（4bit）与两档对照——同样属验收证据，按档位分文件存放，
# 避免跑 4bit 时把 8bit 的证据覆盖掉（见 qwen_precision.py::_report_paths）。
!/artifacts/qwen_precision_report_4bit.md
!/artifacts/qwen_precision_report_4bit.json
!/artifacts/qwen_precision_compare.md
!/artifacts/qwen_precision_compare.json
!/artifacts/local_llm_verify.json
# K2 达标率实测（本地模型真跑卡池解析）——决定是否启用 ADR-LLM-001 云端保底的依据。
# 注意：脚本自己写 `artifacts/_k2_eval_audit.jsonl`（临时审计），**不**在此放行。
!/artifacts/k2_local_eval.md
!/artifacts/k2_local_eval.json
!/artifacts/k2_local_eval_4bit.md
!/artifacts/k2_local_eval_4bit.json
# 定向重跑（修复效果验证）+ 黄金集 LLM 实测 + 改动前基线对照
# （后者是「P1-1 让黄金集 -6pp 是口径分歧而非变差」这一结论的唯一证据，必须留痕）
!/artifacts/k2_local_eval_rerun.md
!/artifacts/k2_local_eval_rerun.json
# K1 达标证据（对规则基线双盲 200 局）—— rich 动作特征使 0.695 → 0.790
# ⚠ 路径注意：这些产物由脚本以 cwd=packages/agent 写出 → 落在 **packages/agent/artifacts/**，
#   根锚定的 `!/artifacts/...` 白名单**不覆盖**它（`artifacts/` 规则会先命中）。
# 是「K1 PASS」的唯一凭据：正式验收 + 独立 seed 复验 + 同 seed 对照 + 搜索对照 + 标定
!/packages/agent/artifacts/
/packages/agent/artifacts/*
!/packages/agent/artifacts/k1_richfull.md
!/packages/agent/artifacts/k1_richfull.json
!/packages/agent/artifacts/k1_rich40k.md
!/packages/agent/artifacts/k1_rich40k.json
!/packages/agent/artifacts/k1_fire_rich.md
!/packages/agent/artifacts/k1_fire_rich.json
!/packages/agent/artifacts/k1_fire_basic.md
!/packages/agent/artifacts/k1_fire_basic.json
!/packages/agent/artifacts/K1_accept_variants.md
!/packages/agent/artifacts/K1_accept_variants.json
!/packages/agent/artifacts/K1_accept_variants_seed1000.md
!/packages/agent/artifacts/K1_accept_variants_seed1000.json
!/packages/agent/artifacts/K1_accept_fire.md
!/packages/agent/artifacts/K1_accept_fire.json
!/packages/agent/artifacts/K1_accept_fire_seed1000.md
!/packages/agent/artifacts/K1_accept_fire_seed1000.json
!/packages/agent/artifacts/k1_migrate.md
!/packages/agent/artifacts/k1_migrate.json
!/packages/agent/artifacts/k1_migrate2.md
!/packages/agent/artifacts/k1_migrate2.json
!/packages/agent/artifacts/k1_rich.md
!/packages/agent/artifacts/k1_basic707.md
!/packages/agent/artifacts/k1_cont40k.md
!/packages/agent/artifacts/k1_hi_ent.md
!/packages/agent/artifacts/k1_wide128.md
!/packages/agent/artifacts/K1_accept.md
!/packages/agent/artifacts/K1_accept.json
!/packages/agent/artifacts/K1_accept_rich.md
!/packages/agent/artifacts/K1_accept_rich.json
!/packages/agent/artifacts/K1_accept_rich_seed1000.md
!/packages/agent/artifacts/K1_accept_rich_seed1000.json
!/packages/agent/artifacts/K1_accept_rich_mcts.md
!/packages/agent/artifacts/K1_accept_rich_mcts.json
!/packages/agent/artifacts/K1_selfplay_snaps.md
!/packages/agent/artifacts/K1_selfplay_snaps.json
!/packages/agent/artifacts/k1_mcts_sweep.json
!/packages/agent/artifacts/value_calib.md
!/packages/agent/artifacts/value_calib.json
!/packages/agent/artifacts/value_calib_rich.md
!/packages/agent/artifacts/value_calib_rich.json
!/artifacts/k2_report_llm.md
!/artifacts/k2_report_llm.json
!/artifacts/k2_report_llm_before.md
!/artifacts/k2_report_llm_before.json
# 各版提示词实测产物 —— **四版曲线是「示例数 > 长度」这一结论的唯一证据**，
# 必须留痕：v2 32% / v3(精简) 24% / v4(折中) 32% / v5 38%；
# 另有定向集（`_fury`，验证「文本折算口径优先」）与卡池重跑（`_rerun4`，验证归一化）。
!/artifacts/k2_report_llm_v3.md
!/artifacts/k2_report_llm_v3.json
!/artifacts/k2_report_llm_v4.md
!/artifacts/k2_report_llm_v4.json
!/artifacts/k2_report_llm_v5.md
!/artifacts/k2_report_llm_v5.json
!/artifacts/k2_report_llm_v6.md
!/artifacts/k2_report_llm_v6.json
!/artifacts/k2_report_llm_fury.md
!/artifacts/k2_report_llm_fury.json
!/artifacts/k2_local_eval_rerun4.md
!/artifacts/k2_local_eval_rerun4.json
# 云端保底实测（真实 deepseek-chat）—— 证明「瓶颈不在模型规模」的关键证据
!/artifacts/k2_report_cloud.md
!/artifacts/k2_report_cloud.json
!/artifacts/k2_report_cloud2.md
!/artifacts/k2_report_cloud2.json
!/artifacts/k2_report_cloud3.md
!/artifacts/k2_report_cloud3.json
# 后续各轮只留机读结果（其 .md 明细在中途清理时被删；四轮曲线见
# artifacts/k2_p1_validation_report.md 的 8.11 节）
!/artifacts/k2_report_cloud4.json
!/artifacts/k2_report_cloud5.json
!/artifacts/k2_report_cloud6.md
!/artifacts/k2_report_cloud6.json
# 注：`_k2_eval_audit*.jsonl`（审计，含 tag 后缀）与 `k2_local_eval_rerun[^4]*`
# 等中间产物仍被忽略 —— 只保留有结论价值的那几份。

